# Set these in Vercel: Project > Settings > Environment Variables (Production + Preview).
# Never put them in the website files or commit real values.
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-the-service_role-key-here
# any long random text; used to hash visitor IPs for spam limiting
IP_SALT=change-me-to-random-text
